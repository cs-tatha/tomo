# Environment configuration for Real-Time Collaborative Workspace

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/realtime_workspace?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_token_key_change_in_production_123456
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_in_production_654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Chat Configuration
CHAT_MESSAGE_TTL_SECONDS=86400
